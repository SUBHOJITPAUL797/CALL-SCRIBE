{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callscribe-ai",
  "main": "worker.js",
  "compatibility_date": "2024-09-01",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Optional secret token: uncomment and set your secret token here, or in Cloudflare Dashboard -> Settings -> Variables
    // "API_TOKEN": "my-secret-callscribe-password"
  },
  "observability": {
    "enabled": true
  }
}
